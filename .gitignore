# =============================================================================
# TRADING DATA - DO NOT COMMIT
# =============================================================================

# Market data
*.csv
!requirements*.csv  # Allow requirements files
!data/examples/*.csv  # Allow example data

# Data directories
PACIFICA_data/
PACIFICA_data/*
!PACIFICA_data/.gitkeep

# Trading parameters (contains live positions/balances)
params/*.json
params/**/*.json
!params/example_*.json  # Allow example configs

# Logs (may contain sensitive info)
*.log
*.log.*
!example.log  # Allow example log
logs/

# Database files
*.db
*.sqlite
*.sqlite3
*.db-journal

# Cache files
.cache/
.mypy_cache/
.pytest_cache/
__pycache__/

