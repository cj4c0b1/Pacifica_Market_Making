# =============================================================================
# SENSITIVE DATA - NEVER COMMIT
# =============================================================================

# Environment variables & secrets
.env
.env.*
!.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local

# API keys and certificates
*.key
*.pem
*.crt
*.cert

# Authentication and secrets
*_secret*
*_private*
secrets.*
credentials.*

# Wallet & keys
wallet*.json
keypair*.json
id.json
*.keystore
*.jks

# Configuration overrides
config_*.json
config_*.yaml
config_*.yml

